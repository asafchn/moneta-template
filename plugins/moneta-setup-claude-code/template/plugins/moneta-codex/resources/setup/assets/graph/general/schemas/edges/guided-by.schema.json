{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moneta.invalid/schemas/edges/guided-by.schema.json",
  "title": "guided-by",
  "description": "Use of this invocation, skill or flow is governed by the target guideline.",
  "type": "object",
  "properties": {
    "type": {
      "const": "guided-by"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "required": [
    "type",
    "target"
  ],
  "additionalProperties": false
}
