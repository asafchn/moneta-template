{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private machine-local Moneta checkout configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "repository",
    "checkout",
    "branch",
    "revision",
    "last-successful-pull-at",
    "graph-root"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "namespace"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checkout": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "last-successful-pull-at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "graph-root": {
      "type": "string",
      "minLength": 1
    }
  }
}
