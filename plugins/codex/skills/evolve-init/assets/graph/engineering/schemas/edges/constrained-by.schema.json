{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolve.invalid/schemas/edges/constrained-by.schema.json",
  "title": "constrained-by",
  "description": "The target guardrail constrains the behavior described by this node.",
  "type": "object",
  "properties": {
    "type": {
      "const": "constrained-by"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "required": [
    "type",
    "target"
  ],
  "additionalProperties": false
}
