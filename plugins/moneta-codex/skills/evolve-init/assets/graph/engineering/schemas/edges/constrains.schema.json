{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moneta.invalid/schemas/edges/constrains.schema.json",
  "title": "constrains",
  "description": "This guardrail constrains the behavior described by the target node.",
  "type": "object",
  "properties": {
    "type": {
      "const": "constrains"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "required": [
    "type",
    "target"
  ],
  "additionalProperties": false
}
