{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moneta.invalid/schemas/node-base.schema.json",
  "title": "Common operational-node frontmatter",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "node-type": {
      "enum": [
        "tool-calls",
        "coding-guidelines",
        "agent-responsibility",
        "skills",
        "guard-rails",
        "agentic-flow context",
        "schemas"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "data": {
      "type": "object"
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "edge.schema.json"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "location",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "slug",
    "node-type",
    "description",
    "tags",
    "scope",
    "data",
    "relations"
  ]
}
