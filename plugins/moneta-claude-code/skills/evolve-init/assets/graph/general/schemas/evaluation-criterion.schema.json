{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moneta.invalid/schemas/evaluation-criterion.schema.json",
  "title": "Evaluation criterion frontmatter",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scale": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "value",
                "meaning"
              ],
              "additionalProperties": false
            },
            "description": "Optional explicit scoring rubric. No universal admission score is supplied by this package."
          },
          "method": {
            "enum": [
              "deterministic-check",
              "agent-judgment",
              "human-judgment"
            ]
          },
          "measure": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "method",
          "measure"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "description",
    "status",
    "dimensions"
  ],
  "additionalProperties": false
}
