{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolve.invalid/schemas/nodes/schemas.schema.json",
  "title": "schemas",
  "allOf": [
    {
      "$ref": "../node-base.schema.json"
    },
    {
      "properties": {
        "node-type": {
          "const": "schemas"
        },
        "data": {
          "type": "object",
          "properties": {
            "schema-id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "definition": {
              "type": "object"
            }
          },
          "required": [
            "schema-id",
            "definition"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
