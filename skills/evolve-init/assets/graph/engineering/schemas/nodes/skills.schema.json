{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolve.invalid/schemas/nodes/skills.schema.json",
  "title": "skills",
  "allOf": [
    {
      "$ref": "../node-base.schema.json"
    },
    {
      "properties": {
        "node-type": {
          "const": "skills"
        },
        "data": {
          "type": "object",
          "properties": {
            "invocation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "invocation",
            "purpose"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
