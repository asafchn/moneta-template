{
  "description": "Prompt area-scoped retrieval through native lifecycle context.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','context.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','context.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','context.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','context.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
