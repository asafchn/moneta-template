{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolve.invalid/schemas/workspace.schema.json",
  "title": "Workspace connection frontmatter",
  "type": "object",
  "properties": {
    "repository-url": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "hosting": {
      "enum": [
        "auto",
        "gitlab",
        "github"
      ]
    },
    "checkout": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "graph-root": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evaluation-root": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "domain-source": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "access": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "location",
            "access"
          ],
          "additionalProperties": false
        }
      ]
    },
    "base-branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Reviewed branch used for ordinary retrieval; discovered from the supplied repository."
    }
  },
  "required": [
    "repository-url",
    "hosting",
    "checkout",
    "graph-root",
    "evaluation-root",
    "domain-source",
    "base-branch"
  ],
  "additionalProperties": false
}
